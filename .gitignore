# .gitignore for the LEN-Small study.
# The raw LEN dataset must NEVER be committed (see data/DATA_MANIFEST.md).

# --- Raw dataset and any copy of it ---------------------------------------
small_encoder_final.tar
small_encoder_final/
encoder_final.tar
metadata_graph.json
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tar.xz
*.zip
*.7z
*.rar
*.gz
# Extracted raw graph files: <hashtag>_(non)campaign_fulldata.json
*_fulldata.json
*_fulldata.*
data/raw/

# --- Generated bulk data (regenerated by run_pipeline.py) ------------------
# Contains edges and cleaned message text from the raw dataset.
data/processed/
# Local isolated reproduction runs
repro/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# --- Node / website build --------------------------------------------------
node_modules/
frontend/dist/
dist-ssr/
*.local

# --- Logs and temporary files ----------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.swp
*~
# Microsoft Office lock and temporary files
~$*
~WRL*.tmp

# --- Editors, OS and local machine configuration ---------------------------
.vscode/
.idea/
.claude/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# --- Credentials and secrets -----------------------------------------------
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
*token*.txt
